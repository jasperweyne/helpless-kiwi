{% extends 'admin/layout.html.twig' %}

{% if page_title is not defined %}
    {% set page_title = 'Gebeurtenislog' %}
{% endif %}

{% block results %}
    <span class="text-neutral-300">
    {{ pagination.getTotalItemCount() ?? log|length }} resultaten gevonden
    </span>
{% endblock %}

{% block body %}
    <div class="table">
        <table>
            <thead>
                <tr>
                    <th>Naam</th>
                    <th>Tijd</th>
                    <th>Gebruiker</th>
                </tr>
            </thead>
            <tbody>
            {% for event in log %}
                <tr>
                    <td>{{ event.title }}</td>
                    <td>{{ event.time|date('d-m-Y H:i') }}</td>
                    <td>{{ event.person.canonical ?? 'Onbekend' }}</td>
                </tr>
            {% else %}
                <tr>
                    <td>Geen gebeurtenissen.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block pagination %}
{{ include('components/pagination.html.twig', {'pagination': pagination}) }}
{% endblock %}


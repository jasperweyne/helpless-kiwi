{% extends 'admin/layout.html.twig' %}

{% if page_title is not defined %}
    {% set page_title = 'Accounts' %}
{% endif %}

{% set resultcount = pagination.getTotalItemCount() %}

{% block buttons %}
    <a href="{{ path("admin_security_new") }} ">Nieuw</a>
    <a href="{{ path("admin_security_import") }} ">Importeren</a>
{% endblock %}

{% block search %}
<div class="mb-3">
{{ include('components/search.html.twig', {'placeholder': 'Naam of e-mail'}) }}
</div>
{% endblock %}

{% block body %}
    <div class="table">
        <table>
            <thead>
                <tr>
                    <th>Naam</th>
                    <th>E-mail</th>
                    <th>Administrator</th>
                    <th>{{ oidc ? 'Lokale login' : 'Geactiveerd' }}</th>
                    {% if oidc %}
                        <th>Externe login</th>
                    {% endif %}
                </tr>
            </thead>
            <tbody>
            {% for account in pagination %}
                <tr>
                    <td><a href="{{ path("admin_security_show", { 'account': account.id }) }}">{{ account.canonical ?? '{onbekend}'}}</a></td>
                    <td>{{ account.email }}</td>
                    <td>{{ 'ROLE_ADMIN' in account.roles ? 'Ja' : 'Nee' }}</td>
                    <td>{{ account.password ? 'Ja' : 'Nee' }}</td>
                    {% if oidc %}
                        <td>{{ account.oidc ? 'Ja' : 'Nee' }}</td>
                    {% endif %}
                </tr>
            {% else %}
                <tr>
                    <td>Geen accounts.</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}

{% block pagination %}
{{ include('components/pagination.html.twig', {'pagination': pagination}) }}
{% endblock %}
